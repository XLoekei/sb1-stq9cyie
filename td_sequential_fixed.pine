//@version=6
indicator("TD Sequential: Simple + Visual", overlay = true)

showTD9 = input.bool(true, "✅ Show TD9 Signals")

var int tdCount = 0
var int tdDir   = 0

prevTdCount = nz(tdCount[1], 0)
prevTdDir   = nz(tdDir[1], 0)

canCompare = bar_index >= 4
isUp   = canCompare ? close > close[4] : false
isDown = canCompare ? close < close[4] : false

if not canCompare
    tdDir := prevTdDir
    tdCount := prevTdCount
else if isUp
    tdDir := 1
    tdCount := prevTdDir == 1 ? prevTdCount + 1 : 1
else if isDown
    tdDir := -1
    tdCount := prevTdDir == -1 ? prevTdCount + 1 : 1
else
    tdDir := prevTdDir
    tdCount := prevTdCount

// === TD9 Buy Signal ===
plotshape(
    showTD9 and tdCount == 9 and tdDir == 1,
    title     = "TD9 Buy Signal",
    location  = location.belowbar,
    color     = color.new(color.lime, 0),
    style     = shape.triangleup,
    size      = size.large
)

// === TD9 Sell Signal ===
plotshape(
    showTD9 and tdCount == 9 and tdDir == -1,
    title     = "TD9 Sell Signal",
    location  = location.abovebar,
    color     = color.new(color.red, 0),
    style     = shape.triangledown,
    size      = size.large
)
